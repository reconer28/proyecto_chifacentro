<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de inicio de Android cuando el modo oscuro del sistema está activado. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Muestra la pantalla de inicio hasta que el motor de Flutter dibuja el primer fotograma. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Tema de la ventana de Android al iniciar el proceso. Define su color mientras carga la interfaz de Flutter y el fondo situado detrás de ella durante la ejecución. Se utiliza desde la versión 2 de la integración de Flutter con Android. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
